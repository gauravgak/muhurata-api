# Copy to .env for local dev:  cp .env.example .env
# Render sets these in the dashboard (Environment tab). NEVER commit a real .env.

# ---------------------------------------------------------------- database
# Local dev leaves DATABASE_URL empty -> SQLite at ./muhurata.db.
# Production: Supabase "Transaction pooler" string, port 6543.
DATABASE_URL=
# Supabase "Direct connection" string, port 5432. Used ONLY by migrate.py.
DIRECT_URL=
# Optional tuning (sane defaults in db.py):
# DB_POOL_MAX=8
# DB_POOL_TIMEOUT=5
# DB_STATEMENT_TIMEOUT_MS=8000
# SQLITE_PATH=muhurata.db

# ---------------------------------------------------------------- auth (Supabase)
# Project ref is the subdomain of your Supabase URL.
SUPABASE_URL=https://YOUR_REF.supabase.co
# Asymmetric verification (preferred). Leave JWT_SECRET empty if you use this.
SUPABASE_JWKS_URL=https://YOUR_REF.supabase.co/auth/v1/.well-known/jwks.json
# Legacy HS256 fallback — Supabase project settings > API > JWT Secret.
SUPABASE_JWT_SECRET=
# Comma-separated emails allowed to hit admin endpoints (/api/leads etc.)
ADMIN_EMAILS=you@example.com

# ---------------------------------------------------------------- whatsapp
WA_TOKEN=
WA_PHONE_ID=
# No default any more — webhook verification fails closed if this is unset.
WA_VERIFY_TOKEN=
# Meta app secret, for X-Hub-Signature-256 verification on the inbound webhook.
WA_APP_SECRET=
WA_BUSINESS_NUMBER=

# ---------------------------------------------------------------- llm (Naksha + predictions)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# NAKSHA_MAX_TOKENS=600

# ---------------------------------------------------------------- misc
# Optional real geocoder fallback for places not in the bundled city list.
GEOCODER_URL=
# Optional Cloudflare Turnstile secret for the reading form.
TURNSTILE_SECRET=
